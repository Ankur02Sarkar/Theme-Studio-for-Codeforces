{
"update_url": "https://clients2.google.com/service/update2/crx",

  "manifest_version": 3,
  "name": "Theme Studio for Codeforces – Dark Mode, Themes & Anime Backgrounds",
  "short_name": "Theme Studio",
  "version": "0.2.1",
  "description": "Dark mode and themes for all of Codeforces: problems, standings, status, profiles. Anime scenes, Pixel Art, Vintage Paper, Midnight.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Theme Studio for Codeforces",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "offscreen"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://codeforces.com/*",
        "https://*.codeforces.com/*"
      ],
      "js": [
        "src/themes.js",
        "src/content.js",
        "src/find.js",
        "src/guided.js",
        "src/classic.js",
        "src/pixel/app.js",
        "src/pixel/shatter.js",
        "src/pixel/duel.js",
        "src/pixel/profile.js",
        "src/pixel/raids.js",
        "src/anime/scenes.js",
        "src/anime/css.js",
        "src/anime/cf-glass.js",
        "src/anime/cf-block.js",
        "src/anime/anime.js",
        "src/anime/app.js",
        "src/anime/sakuga.js",
        "src/anime/onair.js",
        "src/anime/manga.js",
        "src/anime/schedule.js",
        "src/anime/character.js",
        "src/anime/home.js",
        "src/anime/dojo.js",
        "src/moments/sounds.js",
        "src/moments/cf-sounds.js",
        "src/links.js",
        "src/moments/share.js",
        "src/moments/cf-fx.js",
        "src/moments/cf-moments.js",
        "src/verdicts.js",
        "src/fastlap/shell.js"
      ],
      "css": [
        "themes/core.css",
        "themes/icons.css",
        "themes/guided.css",
        "themes/midnight.css",
        "themes/grid.css",
        "themes/paper.css",
        "themes/pixel.css",
        "themes/pixel-app.css",
        "themes/anime.css",
        "themes/anime-app.css",
        "themes/fastlap.css",
        "themes/fastlap-shell.css",
        "themes/fastlap-tower.css",
        "themes/fastlap-timing.css",
        "themes/fastlap-drive.css",
        "themes/fastlap-paddock.css",
        "themes/fastlap-calendar.css",
        "themes/fastlap-pit.css",
        "themes/fastlap-feed.css",
        "themes/fastlap-side.css",
        "themes/fastlap-season.css",
        "themes/classic.css",
        "themes/fx.css",
        "themes/modern.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://codeforces.com/problemset/problem/*",
        "https://codeforces.com/contest/*/problem/*",
        "https://codeforces.com/gym/*/problem/*",
        "https://*.codeforces.com/problemset/problem/*",
        "https://*.codeforces.com/contest/*/problem/*",
        "https://*.codeforces.com/gym/*/problem/*"
      ],
      "js": [
        "src/modern/spike.js",
        "src/modern/app-css.js",
        "src/modern/compare.js",
        "vendor/dompurify/purify.min.js",
        "src/modern/sanitize.js",
        "src/modern/api.js",
        "src/modern/kit.js",
        "src/modern/app.js",
        "src/modern/run.js",
        "src/modern/submit.js",
        "src/modern/rich.js",
        "src/modern/strip.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://codeforces.com/problemset",
        "https://codeforces.com/problemset?*",
        "https://codeforces.com/problemset/page/*",
        "https://*.codeforces.com/problemset",
        "https://*.codeforces.com/problemset?*",
        "https://*.codeforces.com/problemset/page/*"
      ],
      "js": [
        "src/modern/plist-css.js",
        "src/modern/api.js",
        "src/modern/kit.js",
        "src/modern/plist.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://codeforces.com/contests",
        "https://codeforces.com/contests?*",
        "https://codeforces.com/profile/*",
        "https://codeforces.com/",
        "https://codeforces.com/?*",
        "https://codeforces.com/page/*",
        "https://codeforces.com/top",
        "https://codeforces.com/gyms",
        "https://codeforces.com/gyms?*",
        "https://codeforces.com/friends",
        "https://codeforces.com/contests/with/*",
        "https://codeforces.com/settings/general",
        "https://*.codeforces.com/contests",
        "https://*.codeforces.com/contests?*",
        "https://*.codeforces.com/profile/*"
      ],
      "js": [
        "src/modern/plist-css.js",
        "src/modern/api.js",
        "src/modern/kit.js",
        "src/modern/site.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://codeforces.com/*",
        "https://*.codeforces.com/*"
      ],
      "js": [
        "src/relayout.js",
        "src/graph.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://codeforces.com/problemset/problem/*",
        "https://codeforces.com/contest/*/problem/*",
        "https://codeforces.com/gym/*/problem/*",
        "https://*.codeforces.com/problemset/problem/*",
        "https://*.codeforces.com/contest/*/problem/*",
        "https://*.codeforces.com/gym/*/problem/*"
      ],
      "js": [
        "src/modern/bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://codeforces.com/*/submit*",
        "https://codeforces.com/*/customtest*",
        "https://*.codeforces.com/*/submit*",
        "https://*.codeforces.com/*/customtest*"
      ],
      "js": [
        "src/fastlap/pit-main.js"
      ],
      "run_at": "document_end",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://codeforces.com/*",
        "https://*.codeforces.com/*"
      ],
      "js": [
        "src/modern/kit.js",
        "src/modern/bar.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2",
        "src/fastlap/models/*",
        "textures/fastlap/*",
        "textures/anime/*",
        "textures/anime/cast/*",
        "icons/ui/*",
        "icons/ui/ink/*",
        "textures/paper/*",
        "textures/midnight/*",
        "textures/grid/*",
        "textures/badges/*",
        "textures/pixel/*",
        "icons/mark.svg",
        "src/modern/editor.html",
        "src/modern/editor.js",
        "src/modern/ping.html",
        "src/modern/ping.js",
        "vendor/monaco-editor/vs/*",
        "vendor/monaco-editor/vs/editor/*",
        "vendor/monaco-editor/vs/assets/*",
        "vendor/monaco-editor/vs/basic-languages/*",
        "vendor/monaco-editor/vs/nls/lang/*",
        "src/fastlap/drive.js",
        "src/fastlap/editor.js"
      ],
      "matches": [
        "https://codeforces.com/*",
        "https://*.codeforces.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  }
}
